{% liquid
  assign card_product = card_product
  assign tag_value = blank

  if card_product.metafields.custom.tag != blank
    assign tag_value = product.metafields.custom.tag 
  endif
  assign icon_image = card_product.metafields.custom.icon
  assign subtitle = card_product.metafields.custom.one_line_description
%}

<a
  href="{{ card_product.url }}"
  class="sw-block sw-no-underline sw-h-full sw-transition-all sw-duration-300 hover:sw-scale-y-[1.02]"
>

  <div
    class="
      sw-relative
      sw-rounded-[20px]
      sw-overflow-hidden
      sw-bg-white
      sw-shadow-[0px_4px_20px_rgba(149,76,233,0.12)]
      hover:sw-shadow-[0px_8px_30px_rgba(149,76,233,0.18)]
      sw-transition-all
      sw-duration-300
      sw-flex
      sw-flex-col
      sw-h-full
      sw-border
      sw-border-[#EADCF8]
    "
  >

    <!-- TOP IMAGE -->

    <div class="sw-relative">

      <div
        class="
          sw-aspect-[4/3]
          sw-overflow-hidden
        "
      >

        {% if card_product.featured_image %}

          <img
            src="{{ card_product.featured_image | image_url: width: 700 }}"
            alt="{{ card_product.title }}"
            class="
              sw-w-full
              sw-h-full
              sw-object-cover
            "
            loading="lazy"
            width="700"
            height="525"
          >

        {% endif %}

      </div>

      <!-- WHITE OVERLAY -->

      <div
        class="
          sw-absolute
          sw-bottom-0
          sw-left-0
          sw-right-0
          sw-h-[110px]
          sw-pointer-events-none
        "
        style="
          background:
          linear-gradient(
            to bottom,
            rgba(255,255,255,0),
            rgba(255,255,255,0.8),
            #ffffff
          );
        "
      ></div>

      <!-- POPULAR TAG -->

      {% if tag_value != blank %}

        <div
          class="
            sw-absolute
            sw-top-3
            sw-right-3
            sw-bg-fuchsia-500
            sw-text-white
            sw-text-[11px]
            sw-font-semibold
            sw-px-2.5
            sw-py-1
            sw-rounded-full
            sw-flex
            sw-items-center
            sw-gap-1
            sw-shadow-md
          "
        >
          {{ tag_value }}
        </div>

      {% endif %}

    </div>

    <!-- CONTENT -->

    <div
      class="
        sw-relative
        sw-z-10
        sw-flex
        sw-flex-col
        sw-items-center
        sw-text-center
        sw-px-1
        lg:sw-px-2
        sw-pb-4
        sw-flex-1
      "
    >

      <!-- ICON -->

      <div
        class="
         
        "
      >

        {% if icon_image != blank %}

          <img
            src="{{ icon_image | image_url: width: 120 }}"
            alt="{{ card_product.title }}"
            class="
              sw-w-[34px]
              sw-h-[34px]
              lg:sw-w-[40px]
              lg:sw-h-[40px]
              sw-object-contain
            "
            width="40"
            height="40"
            loading="lazy"
          >

        {% elsif card_product.images[1] %}

          <img
            src="{{ card_product.images[1] | image_url: width: 120 }}"
            alt="{{ card_product.title }}"
            class="
              sw-w-[34px]
              sw-h-[34px]
              lg:sw-w-[40px]
              lg:sw-h-[40px]
              sw-object-contain
            "
            width="40"
            height="40"
            loading="lazy"
          >

        {% endif %}

      </div>

      <!-- TITLE -->

      <h3
        class="
          sw-text-[18px]
          lg:sw-text-[20px]
          sw-leading-tight
          sw-font-primary
          sw-font-semibold
          sw-text-[#5E189B]
          sw-m-0
          sw-mb-2
        "
      >
        {{ card_product.title }}
      </h3>

      <!-- DESCRIPTION -->

      {% if subtitle != blank %}

        <p
          class="
            sw-text-[13px]
            lg:sw-text-[14px]
            sw-leading-[1.6]
            sw-text-[#9A5FE0]
            sw-font-secondary
            sw-m-0
            sw-mb-3
            sw-max-w-[230px]
          "
        >
          {{ subtitle }}
        </p>

      {% elsif card_product.description != blank %}

        <p
          class="
            sw-text-[13px]
            lg:sw-text-[14px]
            sw-leading-[1.6]
            sw-text-[#9A5FE0]
            sw-font-secondary
            sw-m-0
            sw-mb-3
            sw-line-clamp-2
            sw-max-w-[230px]
          "
        >
          {{ card_product.description | strip_html | truncate: 70 }}
        </p>

      {% endif %}

      <!-- PRICE -->

      <div
        class="
          sw-mt-auto
          sw-w-full
        "
      >

        <p
          class="
            sw-text-[11px]
            sw-text-[#C78BEA]
            sw-font-secondary
            sw-m-0
            sw-mb-1
          "
        >
          starting from
        </p>

        <p
          class="
            sw-text-[24px]
            sw-leading-none
            sw-font-bold
             sw-font-secondary
            sw-m-0
            sw-mb-4
          "
          style="
            color:
            {{ price_color | default: '#CC007A' }}
          "
        >
          {{ card_product.price_min | money }}
        </p>

        <!-- BUTTON -->

        <button
          class="
            sw-w-full
            sw-rounded-full
            sw-py-2
            sw-px-4
            sw-text-[15px]
            sw-font-semibold
            sw-border-0
            sw-font-secondary
            sw-cursor-pointer
            sw-transition-all
            sw-duration-300
            hover:sw-opacity-90
            hover:sw-scale-[0.98]
            sw-shadow-lg
            sw-bg-gradient-to-r sw-from-fuchsia-600 sw-via-purple-600 sw-to-pink-600
          "
          style="
           
            color:
            {{ button_text_color | default: '#ffffff' }}
          "
          onclick="
            event.preventDefault();
            window.location.href='{{ card_product.url }}'
          "
        >

          Book Now

        </button>

      </div>

    </div>

  </div>

</a>