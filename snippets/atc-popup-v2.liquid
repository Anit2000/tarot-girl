<atc-popup class="sw-group/atcPopup hidden">
    <div data-role="wrapper" class="sw-max-w-[200px] sw-w-full sw-fixed sw-top-[160px] sw-left-1/2 -sw-translate-x-1/2 sw-z-[10002]">
        <div class="group-[&.success]/atcPopup:sw-block sw-hidden sw-bg-[linear-gradient(135deg,_rgb(236,_72,_153)_0%,_rgb(192,_38,_211)_50%,_rgb(147,_51,_234)_100%)] sw-text-[14px] sw-font-secondary sw-w-full sw-rounded-full sw-shadow-md hover:sw-scale-[0.95] sw-transition-all sw-px-2 sw-py-3 sw-text-center sw-items-center sw-justify-center sw-gap-2 sw-text-[#fff]">
            <span>Added to cart</span>
            {% render 'icons-v2', icon: 'cart-star' %}
        </div>
        <div class="sw-bg-[rgb(236,72,153)] group-[&.failed]/atcPopup:sw-flex sw-hidden sw-text-[14px] sw-font-secondary sw-w-full sw-rounded-full sw-shadow-md hover:sw-scale-[0.95] sw-transition-all sw-px-2 sw-py-3 sw-text-center sw-items-center sw-justify-center sw-gap-2 sw-text-[#fff]">
            <span>Failed to add to cart</span>
            <span>{% render 'icons-v2', icon: 'error', classes: 'sw-w-[20px] sw-h-[20px]' %}</span>
        </div>
    </div>
</atc-popup>