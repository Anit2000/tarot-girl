<fbt-item class="sw-flex-[0_0_48%] sw-relative sw-group/fbt">
    <script type="application/json" data-id="fbt-product">{{ product | json }}</script>
    <div class="sw-bg-[#fff] sw-border-[1px_solid_rgba(168,85,247,0.12)] sw-rounded-[16px] sw-p-[14px] sw-shadow-[rgba(168,85,247,0.25)_0px_6px_16px_-10px]">
    <div>
      <div class="sw-relative sw-overflow-hidden sw-shadow-[rgba(88,_28,_135,_0.4)_0px_6px_14px_-4px] sw-bg-[linear-gradient(135deg,_rgb(192,_38,_211)_0%,_rgb(126,_34,_206)_100%)] sw-w-[70px] sw-h-[70px] sw-rounded-[16px]">
        {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 100, height: 100 | image_tag: loading: 'lazy', class }}
        {% endif %}
      </div>
    </div>
    <div class="sw-mt-2">
        <p class="sw-font-primary sw-text-[16px] sw-line-clamp-1 sw-text-[#581c87]">{{ product.title }}</p>
        <div class="sw-flex sw-gap-[6px] sw-mt-1">
            <p class="sw-font-secondary sw-text-[14px] sw-text-[#581c87]">{{ product.price | money }}</p>
            {% if product.compare_at_price > product.price %}
                <p class="sw-font-secondary sw-text-[14px] sw-text-[#6b21a8c7] [text-decoration:line-through]">{{ product.compare_at_price | money }}</p>
            {% endif %}
        </div>
        <form>
            <button class="sw-font-secondary sw-w-full sw-bg-[linear-gradient(135deg,rgb(236,72,153),rgb(168,85,247))] sw-text-[#fff] sw-text-[14px] sw-flex sw-items-center sw-gap-1 sw-justify-center sw-py-2 sw-rounded-[16px] sw-mt-[10px]"><span class="group-[&.loading]/fbt:sw-hidden sw-flex">{% render 'icons-v2' , icon: 'qn-plus', classes: 'sw-fill-[#fff] sw-w-3' %}<span>Add to cart</span></span>{% render 'loader-v2', classes: 'sw-w-5 sw-h-5 group-[&.loading]/fbt:sw-block sw-hidden  sw-text-[#fff] sw-fill-[rgb(107,33,168)]' %}</button>
        </form>
    </div>
  </div>
</fbt-item>
