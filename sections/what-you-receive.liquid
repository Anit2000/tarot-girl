{% comment %}
  Section : what-you-receive.liquid
  Design  : Modern Tarot — "What You'll Receive" plain text cards
  Features: Heading, up to 10 item blocks — all Theme Editor editable
  Tested  : mobile 375px / tablet 768px / desktop 1280px+
{% endcomment %}

<div id="wr-{{ section.id }}" class="wr">
  <div class="wr__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="wr__heading">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_emoji != blank -%}
          <span aria-hidden="true"> {{ section.settings.heading_emoji }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="wr__list" role="list">
        {%- for block in section.blocks -%}
          <li class="wr__item" {{ block.shopify_attributes }}>
            <p class="wr__item-text">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</div>

<style>
  #wr-{{ section.id }},
  #wr-{{ section.id }} * { box-sizing: border-box; }
  #wr-{{ section.id }} p,
  #wr-{{ section.id }} h2 { margin: 0; padding: 0; }

  #wr-{{ section.id }} {
    --col-bg:          {{ section.settings.section_bg }};
    --col-heading:     {{ section.settings.heading_color }};
    --col-card-bg:     {{ section.settings.card_bg }};
    --col-card-border: {{ section.settings.card_border }};
    --col-text:        {{ section.settings.text_color }};
    --radius-card:     {{ section.settings.card_radius }}px;
    --speed:           0.2s;
    --px:              clamp(1.25rem, 5vw, 4rem);
    --py:              clamp(2.5rem, 5vw, 4rem);
    --max-w:           {{ section.settings.max_width }}px;
  }

  #wr-{{ section.id }} {
    background: var(--col-bg);
    padding: var(--py) var(--px);
    font-family: inherit;
  }

  #wr-{{ section.id }} .wr__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  /* Heading */
  #wr-{{ section.id }} .wr__heading {
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: var(--col-heading);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-align: center;
  }

  /* List */
  #wr-{{ section.id }} .wr__list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_gap }}px;
  }

  /* Card */
  #wr-{{ section.id }} .wr__item {
    background: var(--col-card-bg);
    border: 1px solid var(--col-card-border);
    border-radius: var(--radius-card);
    padding: 1.1rem 1.5rem;
    transition: transform var(--speed) ease, box-shadow var(--speed) ease;
  }
  #wr-{{ section.id }} .wr__item:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 18px rgba(100, 0, 160, 0.07);
  }

  /* Text */
  #wr-{{ section.id }} .wr__item-text {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--col-text);
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    #wr-{{ section.id }} .wr__item { padding: 0.9rem 1.1rem; }
    #wr-{{ section.id }} .wr__item-text { font-size: 13.5px; }
  }
</style>

{% schema %}
{
  "name": "What You'll Receive",
  "tag": "section",
  "class": "what-you-receive-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f5eeff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What You'll Receive"
    },
    {
      "type": "text",
      "id": "heading_emoji",
      "label": "Heading emoji",
      "info": "Leave blank to hide",
      "default": "Heading emoji"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#2d1460"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border colour",
      "default": "#ede8f8"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between cards",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text colour",
      "default": "#4c1d95"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 600,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "default": 880
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": "For question readings, you will receive answers with a full detailed tarot reading for each question."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What You'll Receive",
      "category": "Custom",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "For question readings, you will receive answers with a full detailed tarot reading for each question."
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "For Yes/No readings, you will receive only a direct Yes or No answer, not a detailed reading."
          }
        }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}