{% liquid
  assign menu_handle = section.settings.menu
%}
{% style %}
  #shopify-section-{{ section.id }}{
    position: sticky;
    top: 0px;
    z-index: 1000;
    background: #fff;
  }
{% endstyle %}
<header-navigation
  class="sw-block sw-w-full">

  <header
    class="sw-relative sw-bg-gradient-to-r sw-from-pink-50 sw-via-purple-50 sw-to-fuchsia-50 sw-border-b sw-border-purple-200/40 sw-shadow-sm"
  >

    <div class="sw-max-w-7xl sw-mx-auto sw-px-4 sw-py-2">

      <div class="sw-flex sw-items-center sw-justify-between">

        <!-- LOGO -->

        <a
          href="{{ routes.root_url }}"
          class="sw-flex sw-items-center sw-gap-2 sw-no-underline"
        >

          <div
            class="sw-w-9 sw-h-9 sm:sw-w-10 sm:sw-h-10 sw-rounded-full sw-bg-gradient-to-br sw-from-fuchsia-500 sw-via-purple-500 sw-to-pink-500 sw-border-2 sw-border-white/80 sw-flex sw-items-center sw-justify-center sw-shadow-lg"
          >

            ✨

          </div>

          <div>

            <h1
              class="sw-text-base sm:sw-text-lg sw-tracking-tight sw-leading-none"
            >

              <span
                class="sw-font-primary sw-font-bold sw-text-[#701a75]"
              >
                {{ section.settings.logo_text_first }}
              </span>

              <span
                class="sw-text-fuchsia-600 sw-font-semibold"
                style="font-family:'Dancing Script',cursive;"
              >
                {{ section.settings.logo_text_second }}
              </span>

            </h1>

          </div>

        </a>

        <!-- DESKTOP MENU -->

        <div
          class="sw-hidden lg:sw-flex sw-items-center sw-gap-6"
        >

          {% for link in linklists[menu_handle].links %}

            <a
              href="{{ link.url }}"
              class="sw-text-purple-900 hover:sw-text-fuchsia-600 sw-transition-colors sw-duration-300 sw-text-xs sw-uppercase sw-tracking-wider sw-font-secondary sw-font-medium"
              data-nav-link
            >
              {{ link.title }}
            </a>

          {% endfor %}

        </div>

        <!-- MOBILE TOGGLE -->
        <div class="sw-flex sw-gap-2 sw-items-center">
          <button
            class="lg:sw-hidden sw-flex sw-items-center sw-justify-center sw-w-10 sw-h-10 sw-rounded-full hover:sw-bg-purple-100 sw-transition-all"
            data-role="mobile-toggle"
            aria-label="Open Menu"
          >
            {% render 'icons-v2', icon: 'hamburger', classes: 'sw-w-[24px]' %}
          </button>
          <button data-role="cart-btn" class="sw-relative">
            {% render 'icons-v2', icon: 'cart', classes: 'sw-w-[24px]' %}
            <span data-role="cart-count" class="{% if cart.item_count > 0 %} active {% endif %} sw-min-w-[23px] sw-min-h-[23px] sw-hidden [&.active]:sw-block sw-absolute sw-font-secondary sw-top-0 sw-right-0 sw-text-[10px] sw-text-[#fff] -sw-translate-y-1/2 sw-translate-x-1 sw-rounded-full sw-px-2 sw-py-1 sw-bg-[linear-gradient(135deg,_rgb(236,_72,_153),_rgb(168,_85,_247))]">{{ cart.item_count }}</span>
          </button>
        </div>
      </div>

    </div>
    {% if section.settings.search_input %}
    <search-form>
      {%- liquid
        assign total_search_animation = 0
        assign current_rendering_count = 0
        for block in section.blocks
          if block.type == 'search_animated_text' 
            assign total_search_animation = total_search_animation | plus: 1
          endif
        endfor
      -%}
      <script type="applicationId/json" data-id="searh-configs">
        {
          "search_animation":{{ section.settings.search_type_animation }},
          "search_animation_text":[
            {%- for block in section.blocks  -%}
              {%- if block.type == 'search_animated_text' -%}
                {%- assign current_rendering_count = current_rendering_count | plus : 1 -%}
                {
                  "text":"{{ block.settings.text }}"
                }{%- if current_rendering_count < total_search_animation -%},
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      </script>
      <form>
        <div class="sw-bg-[linear-gradient(rgb(252,245,255)_0%,_rgb(253,242,248)_100%)]">
          <div class="sw-px-3 sw-pb-2">
            <div class="sw-flex sw-gap-[3px] sw-bg-[#fff] sw-items-center sw-px-2 sw-rounded-[12px]">
               <label for="search-input">{% render 'icons-v2', icon:'icon-search' %}</label>
               <input name="search" id="search-input" data-role="search-input" class="sw-w-full sw-text-[14px] sw-font-secondary sw-text-[#581c87] sw-outline-none sw-border-0 sw-border-[1px_solid_rgba(168,85,247,0.1)] sw-rounded-[16px] sw-p-[10px_12px]">
            </div>
          </div>
        </div>
      </form>

    </search-form>
  {% endif %}
  </header>

  <!-- MOBILE PANEL -->

  <div
    class="sw-fixed sw-inset-0 sw-z-[999] sw-pointer-events-none"
    data-role="mobile-overlay"
  >

    <!-- BACKDROP -->

    <div
      class="sw-absolute sw-inset-0 sw-bg-black/40 sw-opacity-0 sw-transition-all sw-duration-300"
      data-role="backdrop"
    ></div>

    <!-- PANEL -->

    <div
      class="sw-absolute sw-top-0 sw-right-0 sw-h-full sw-w-[280px] sw-bg-white sw-shadow-2xl sw-translate-x-full sw-transition-transform sw-duration-300 sw-flex sw-flex-col"
      data-role="mobile-panel"
    >

      <!-- HEADER -->

      <div
        class="sw-flex sw-items-center sw-justify-between sw-px-5 sw-py-4 sw-border-b"
      >

        <h3
          class="sw-text-lg sw-font-semibold sw-text-purple-900"
        >
          Menu
        </h3>

        <button
          class="sw-w-9 sw-h-9 sw-rounded-full hover:sw-bg-gray-100"
          data-role="mobile-close"
        >
          ✕
        </button>

      </div>

      <!-- LINKS -->

      <div
        class="sw-flex sw-flex-col sw-px-5 sw-py-5 sw-gap-5"
      >

        {% for link in linklists[menu_handle].links %}

          <a
            href="{{ link.url }}"
            class="sw-text-purple-900 hover:sw-text-fuchsia-600 sw-transition-all sw-duration-300 sw-text-sm sw-uppercase sw-tracking-wider sw-font-secondary sw-font-medium"
            data-mobile-link
          >
            {{ link.title }}
          </a>

        {% endfor %}

      </div>

    </div>

  </div>

</header-navigation>

<style>

html{
  scroll-behavior:smooth;
}

section[id]{
  scroll-margin-top:90px;
}

</style>
 {% render 'vite-tag' with 'header-v2.js' %}
 {% if section.settings.search_input %}
    {% render 'vite-tag' with 'search-v2.js' %}
    {% render 'search-popup-v2', section: section %}
 {% endif %}
{% schema %}
{
  "name": "Tarot Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text_first",
      "label": "Logo First Text",
      "default": "Tarot"
    },
    {
      "type": "text",
      "id": "logo_text_second",
      "label": "Logo Second Text",
      "default": "Girl"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    },
    {
      "type":"header",
      "content":"Search configuration",
    },
    {
      "type":"checkbox",
      "label":"Display search input on header",
      "id":"search_input",
      "default": true
    },
    {
      "type":"checkbox",
      "label":"Enable text typing animation",
      "id":"search_type_animation",
      "default":true
    },
    {
      "type":"checkbox",
      "label":"Show trending searches",
      "id":"trending_searches",
      "default": true
    },
    {
      "type":"text",
      "label":"Search keyword title",
      "id":"search_keyword_title",
      "default":"Treding searches",
      "visible_if":"{{ section.settings.trending_searches == true }}"
    },
    {
      "type":"textarea",
      "label":"Search keywords",
      "id":"search_keywords",
      "info": "Coma seperated search keywords Ex - All,Love,Career",
      "visible_if":"{{ section.settings.trending_searches == true }}"
    },
    {
      "type":"checkbox",
      "label":"Show recommended products",
      "id":"recommended_products",
      "default":true
    },
    {
      "type":"text",
      "label":"Recommended products title",
      "id":"recommended_products_title",
      "default":"Recommended Products",
      "visible_if": "{{ section.settings.recommended_products == true }}"
    },
    {
      "type":"collection",
      "label":"Choose recommended products collection",
      "id":"recommended_collection",
    },
    {
      "type":"number",
      "label":"Number of products to show",
      "id":"recommended_products_count",
      "default":4
    }
  ],
  "blocks": [
    {
      "type":"search_animated_text",
      "name":"Animated search text",
      "settings": [
        {
          "type":"text",
          "label":"Enter animation text",
          "id":"text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tarot Header"
    }
  ]
}
{% endschema %}