{% liquid
  assign blocks_to_render = 0

  for block in section.blocks
    if block.type == 'announcement'
      assign blocks_to_render = blocks_to_render | plus: 1
    endif
  endfor
%}

{% if blocks_to_render > 0 %}
<announcement-bar
  id="sw-announcement-bar"
  class="sw-relative sw-block sw-w-full sw-overflow-hidden sw-bg-gradient-to-r sw-from-fuchsia-600 sw-via-purple-600 sw-to-pink-600 sw-text-white sw-py-3  sw-px-4"
  data-autoplay="{{ section.settings.autoplay }}"
  data-time="{{ section.settings.autoplay_time }}">

  {% if section.settings.show_sparkles %}
    <div class="sw-absolute sw-inset-0 sw-overflow-hidden sw-pointer-events-none sw-opacity-30">

      <span class="sw-absolute sw-top-1 sw-left-[15%] sw-text-[12px] sw-animate-[twinkle_2s_ease-in-out_infinite]">
        ✨
      </span>

      <span class="sw-absolute sw-top-2 sw-left-[45%] sw-text-[12px] sw-animate-[twinkle_2.5s_ease-in-out_infinite_0.5s]">
        ✨
      </span>

      <span class="sw-absolute sw-top-1 sw-left-[75%] sw-text-[12px] sw-animate-[twinkle_3s_ease-in-out_infinite_1s]">
        ✨
      </span>

    </div>
  {% endif %}

  <div class="sw-relative sw-max-w-7xl sw-mx-auto sw-flex sw-items-center sw-justify-center">

    {% if section.settings.display_arrows %}
      <button
        data-role="prev"
        class="sw-absolute sw-left-0 sw-top-1/2 sw--translate-y-1/2 sw-text-white sw-bg-transparent sw-border-0 sw-cursor-pointer sw-z-[2] sw-text-[18px]"
      >
        &#10094;
      </button>
    {% endif %}

    <div
      class="keen-slider sw-w-full"
      data-role="container"
    >

      {% for block in section.blocks %}

        <div
          class="keen-slider__slide sw-flex sw-items-center sw-justify-center sw-text-center"
          data-role="announcement-strip"
          data-behavior="{{ block.settings.behavior }}"
          data-content="{{ block.settings.copy_text_content }}"
          data-text="{{ block.settings.announcement_text | strip_html }}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.behavior == 'redirect' and block.settings.announcement_link != blank %}

            <a
              href="{{ block.settings.announcement_link }}"
              class="sw-text-center sw-text-sm sm:sw-text-base sw-font-semibold sw-tracking-wide sw-text-white sw-no-underline"
              style="font-family:'Inter',sans-serif;font-weight:600;"
            >
              {{ block.settings.announcement_text }}
            </a>

          {% elsif block.settings.behavior == 'copy' %}

            <div
              class="sw-inline-flex sw-items-center sw-gap-2 sw-cursor-pointer sw-text-center sw-text-sm sm:sw-text-base sw-font-semibold sw-tracking-wide"
            >

              {{ block.settings.announcement_text }}

              {% if block.settings.copy_icon %}
                <span>📋</span>
              {% endif %}

              <span
                data-role="copied-text"
                class="sw-hidden sw-text-[12px]"
              >
                Copied ✅
              </span>

            </div>

          {% else %}

            <div
              class="sw-text-center sw-text-xs sm:sw-text-base sw-font-semibold sw-tracking-wide sw-font-secondary"
            >
              {{ block.settings.announcement_text }}
            </div>

          {% endif %}

        </div>

      {% endfor %}

    </div>

    {% if section.settings.display_arrows %}
      <button
        data-role="next"
        class="sw-absolute sw-right-10 sw-top-1/2 sw--translate-y-1/2 sw-text-white sw-bg-transparent sw-border-0 sw-cursor-pointer sw-z-[2] sw-text-[18px]"
      >
        &#10095;
      </button>
    {% endif %}

    {% if section.settings.show_close_icon %}
      <button
        data-role="close"
        class="sw-absolute sw-text-base sw-right-0 sm:sw-right-2 sw-top-1/2 sw--translate-y-1/2 sw-p-1 sm:sw-p-[6px]  sw-rounded-full sw-transition-all sw-duration-200 sw-flex sw-items-center sw-justify-center"
        aria-label="Close announcement"
      >
        ✕
      </button>
    {% endif %}

  </div>

</announcement-bar>

<style>

#sw-announcement-bar p{
  margin:0;
}

#sw-announcement-bar .keen-slider{
  height:28px;
  opacity:0;
  transition:opacity .3s ease;
}


@keyframes twinkle {

  0%,100%{
    opacity:0.3;
    transform:scale(1);
  }

  50%{
    opacity:1;
    transform:scale(1.2);
  }

}
</style>

{% endif %}

    {% render 'vite-tag' with 'announcement-bar-v2.js' %}


{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sparkles",
      "label": "Enable Sparkles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close_icon",
      "label": "Show Close Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "display_arrows",
      "label": "Show Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_time",
      "label": "Autoplay Time",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "richtext",
          "id": "announcement_text",
          "label": "Announcement Text",
          "default": "<p>✨ Get 10% OFF on all services - Limited Time! 💫</p>"
        },
        {
          "type": "url",
          "id": "announcement_link",
          "label": "Announcement Link"
        },
        {
          "type": "select",
          "id": "behavior",
          "label": "Behavior",
          "options": [
            {
              "value": "redirect",
              "label": "Redirect"
            },
            {
              "value": "copy",
              "label": "Copy"
            }
          ],
          "default": "redirect"
        },
        {
          "type": "checkbox",
          "id": "copy_icon",
          "label": "Show Copy Icon",
          "default": false
        },
        {
          "type": "text",
          "id": "copy_text_content",
          "label": "Copy Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}