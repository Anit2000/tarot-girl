{% comment %}
  Section : footer-brand.liquid
  Design  : Modern Tarot — centered footer with logo, tagline,
            social icons, CTA button, copyright
  Tested  : mobile 375px / tablet 768px / desktop 1280px+
{% endcomment %}

<footer id="ft-{{ section.id }}" class="ft">

  {%- comment %} ── BRAND NAME ── {%- endcomment %}
{%- if section.settings.brand_name_plain != blank or section.settings.brand_name_script != blank -%}
    <div class="ft__brand">
      {%- if section.settings.brand_sparkle -%}
        <span class="ft__sparkle" aria-hidden="true">✦</span>
      {%- endif -%}
      <span class="ft__brand-name">
        {{ section.settings.brand_name_plain | escape }}<em class="ft__brand-script">{{ section.settings.brand_name_script | escape }}</em>
      </span>
      {%- if section.settings.brand_sparkle -%}
        <span class="ft__sparkle" aria-hidden="true">✦</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment %} ── TAGLINE ── {%- endcomment %}
  {%- if section.settings.tagline != blank -%}
    <p class="ft__tagline">
      {{ section.settings.tagline | escape }}
      {%- if section.settings.tagline_emoji != blank -%}
        <span aria-hidden="true"> {{ section.settings.tagline_emoji }}</span>
      {%- endif -%}
    </p>
  {%- endif -%}

  {%- comment %} ── SOCIAL ICONS ── {%- endcomment %}
  <div class="ft__socials" role="list" aria-label="Social media links">

    {%- if section.settings.whatsapp_url != blank -%}
      <a href="{{ section.settings.whatsapp_url }}" class="ft__social ft__social--whatsapp" target="_blank" rel="noopener noreferrer" role="listitem" aria-label="WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.instagram_url != blank -%}
      <a href="{{ section.settings.instagram_url }}" class="ft__social ft__social--instagram" target="_blank" rel="noopener noreferrer" role="listitem" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if section.settings.email_url != blank -%}
      <a href="mailto:{{ section.settings.email_url }}" class="ft__social ft__social--email" role="listitem" aria-label="Email us">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>
    {%- endif -%}

  </div>

  {%- comment %} ── CTA BUTTON ── {%- endcomment %}
  {%- if section.settings.cta_label != blank -%}
    {% if template contains 'product' %}
      {% assign product_form_id = 'product_form_' | append : product.id %}
     <button
        class="ft__cta"
        type="submit"
        form="{{ product_form_id }}"
        {% if section.settings.cta_url == blank %}aria-disabled="true"{% endif %}
      >
        {{ section.settings.cta_label | escape }}
        {%- if section.settings.cta_emoji != blank -%}
          <span aria-hidden="true"> {{ section.settings.cta_emoji }}</span>
        {%- endif -%}
      </button> 
    {% else %}
      <a
        href="{{ section.settings.cta_url | default: '#' }}"
        class="ft__cta"
        {% if section.settings.cta_url == blank %}aria-disabled="true"{% endif %}
      >
        {{ section.settings.cta_label | escape }}
        {%- if section.settings.cta_emoji != blank -%}
          <span aria-hidden="true"> {{ section.settings.cta_emoji }}</span>
        {%- endif -%}
      </a>
    {% endif %}

  {%- endif -%}

  {%- comment %} ── COPYRIGHT ── {%- endcomment %}
  {%- if section.settings.copyright_text != blank -%}
    <p class="ft__copy">
      {{ section.settings.copyright_text | escape }}
      {%- if section.settings.copyright_emoji != blank -%}
        <span aria-hidden="true"> {{ section.settings.copyright_emoji }}</span>
      {%- endif -%}
      © {{ 'now' | date: '%Y' }} {{ section.settings.copyright_suffix | escape }}
    </p>
  {%- endif -%}

</footer>

<style>
  /* ─────────────────────────────────────────────
     RESET & SCOPE
  ───────────────────────────────────────────── */
  #ft-{{ section.id }},
  #ft-{{ section.id }} * { box-sizing: border-box; }
  #ft-{{ section.id }} p { margin: 0; padding: 0; }

  /* ─────────────────────────────────────────────
     CSS TOKENS
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} {
    --col-bg-from:       {{ section.settings.bg_from }};
    --col-bg-to:         {{ section.settings.bg_to }};
    --col-sparkle:       {{ section.settings.sparkle_color }};
    --col-brand-plain:   {{ section.settings.brand_plain_color }};
    --col-brand-script:  {{ section.settings.brand_script_color }};
    --col-tagline:       {{ section.settings.tagline_color }};
    --col-wa-bg:         {{ section.settings.wa_bg }};
    --col-ig-bg:         {{ section.settings.ig_bg }};
    --col-em-bg:         {{ section.settings.em_bg }};
    --col-social-icon:   {{ section.settings.social_icon_color }};
    --col-cta-from:      {{ section.settings.cta_btn_from }};
    --col-cta-to:        {{ section.settings.cta_btn_to }};
    --col-cta-text:      {{ section.settings.cta_btn_text }};
    --col-copy:          {{ section.settings.copyright_color }};
    --radius-btn:        {{ section.settings.cta_radius }}px;
    --radius-social:     50%;
    --speed:             0.2s;
    --px:                clamp(1.25rem, 5vw, 4rem);
    --py:                clamp(2.5rem, 5vw, 4rem);
  }

  /* ─────────────────────────────────────────────
     FOOTER SHELL
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} {
    background: linear-gradient(160deg, var(--col-bg-from) 0%, var(--col-bg-to) 100%);
    padding: var(--py) var(--px);
    font-family: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    text-align: center;
  }

  /* ─────────────────────────────────────────────
     BRAND NAME
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} .ft__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }
  #ft-{{ section.id }} .ft__sparkle {
    font-size: 18px;
    color: var(--col-sparkle);
    line-height: 1;
  }
  #ft-{{ section.id }} .ft__brand-name {
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--col-brand-plain);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  /* Italic/script portion of brand name */
  #ft-{{ section.id }} .ft__brand-script {
    font-style: italic;
    color: var(--col-brand-script);
    font-weight: 800;
  }

  /* ─────────────────────────────────────────────
     TAGLINE
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} .ft__tagline {
    font-size: 15px;
    color: var(--col-tagline);
    font-weight: 400;
    line-height: 1.5;
    margin-top: -0.3rem;
  }

  /* ─────────────────────────────────────────────
     SOCIAL ICONS
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} .ft__socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  #ft-{{ section.id }} .ft__social {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-social);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--col-social-icon);
    text-decoration: none;
    transition: transform var(--speed) ease, opacity var(--speed) ease;
    flex-shrink: 0;
  }
  #ft-{{ section.id }} .ft__social:hover {
    transform: translateY(-3px) scale(1.08);
    opacity: 0.88;
  }
  #ft-{{ section.id }} .ft__social:active { transform: scale(0.96); }
  #ft-{{ section.id }} .ft__social--whatsapp { background: var(--col-wa-bg); }
  #ft-{{ section.id }} .ft__social--instagram { background: var(--col-ig-bg); }
  #ft-{{ section.id }} .ft__social--email     { background: var(--col-em-bg); }

  /* ─────────────────────────────────────────────
     CTA BUTTON
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} .ft__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--col-cta-text);
    background: linear-gradient(90deg, var(--col-cta-from), var(--col-cta-to));
    border-radius: var(--radius-btn);
    padding: 0.9rem 2.4rem;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(150, 0, 200, 0.3);
    transition: opacity var(--speed) ease, transform var(--speed) ease;
    margin-top: 0.2rem;
  }
  #ft-{{ section.id }} .ft__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }
  #ft-{{ section.id }} .ft__cta:active { transform: translateY(0); }

  /* ─────────────────────────────────────────────
     COPYRIGHT
  ───────────────────────────────────────────── */
  #ft-{{ section.id }} .ft__copy {
    font-size: 13px;
    color: var(--col-copy);
    font-weight: 400;
    line-height: 1.5;
    margin-top: 0.2rem;
  }

  /* ─────────────────────────────────────────────
     MOBILE  ≤ 480px
  ───────────────────────────────────────────── */
  @media (max-width: 480px) {
    #ft-{{ section.id }} .ft__cta {
      font-size: 14px;
      padding: 0.82rem 1.8rem;
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }
    #ft-{{ section.id }} .ft__social {
      width: 42px;
      height: 42px;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Brand",
  "tag": "footer",
  "class": "footer-brand-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_from",
      "label": "Background gradient — start",
      "default": "#f5eaff"
    },
    {
      "type": "color",
      "id": "bg_to",
      "label": "Background gradient — end",
      "default": "#ffe8f8"
    },
    {
      "type": "header",
      "content": "Brand Name"
    },
    {
      "type": "text",
      "id": "brand_name_plain",
      "label": "Brand name — plain part",
      "default": "Tarot",
      "info": "Rendered in bold upright style"
    },
    {
      "type": "text",
      "id": "brand_name_script",
      "label": "Brand name — italic part",
      "default": "Girl",
      "info": "Rendered in italic style with accent colour"
    },
    {
      "type": "checkbox",
      "id": "brand_sparkle",
      "label": "Show ✦ sparkles either side of name",
      "default": true
    },
    {
      "type": "color",
      "id": "sparkle_color",
      "label": "Sparkle colour",
      "default": "#a855f7"
    },
    {
      "type": "color",
      "id": "brand_plain_color",
      "label": "Brand plain text colour",
      "default": "#2d1460"
    },
    {
      "type": "color",
      "id": "brand_script_color",
      "label": "Brand italic text colour",
      "default": "#c026a0"
    },
    {
      "type": "header",
      "content": "Tagline"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline text",
      "default": "Illuminating your path to clarity"
    },
    {
      "type": "text",
      "id": "tagline_emoji",
      "label": "Tagline emoji",
      "default": "✨"
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline colour",
      "default": "#9a60c0"
    },
    {
      "type": "header",
      "content": "Social Icons"
    },
    {
      "type": "text",
      "id": "whatsapp_url",
      "label": "WhatsApp number or link",
      "info": "e.g. https://wa.me/919876543210 — leave blank to hide"
    },
    {
      "type": "color",
      "id": "wa_bg",
      "label": "WhatsApp icon background",
      "default": "#25d366"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "info": "e.g. https://instagram.com/tarotgirl — leave blank to hide"
    },
    {
      "type": "color",
      "id": "ig_bg",
      "label": "Instagram icon background",
      "default": "#cc00bb"
    },
    {
      "type": "text",
      "id": "email_url",
      "label": "Email address",
      "info": "e.g. hello@tarotgirl.com — leave blank to hide"
    },
    {
      "type": "color",
      "id": "em_bg",
      "label": "Email icon background",
      "default": "#7b2fa0"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Icon colour (all)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Book Your First Service"
    },
    {
      "type": "text",
      "id": "cta_emoji",
      "label": "CTA emoji",
      "default": "✨"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "color",
      "id": "cta_btn_from",
      "label": "Button gradient — start",
      "default": "#9b00d0"
    },
    {
      "type": "color",
      "id": "cta_btn_to",
      "label": "Button gradient — end",
      "default": "#e000c0"
    },
    {
      "type": "color",
      "id": "cta_btn_text",
      "label": "Button text colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "Button border radius",
      "min": 4,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright prefix text",
      "default": "Made with",
      "info": "Year is added automatically"
    },
    {
      "type": "text",
      "id": "copyright_emoji",
      "label": "Copyright emoji",
      "default": "🤍"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All rights reserved"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright text colour",
      "default": "#a07abf"
    }
  ],
  "presets": [
    {
      "name": "Footer Brand",
      "category": "Custom"
    }
  ]
}
{% endschema %}