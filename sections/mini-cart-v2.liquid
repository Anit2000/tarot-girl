<mini-cart data-id="{{ section.id }}" class="sw-group/cart sw-hidden {% if cart.item_count == 0 %} empty {% endif %}">
    <script type="applicationId/json" data-id="cart">{{ cart | json }}</script>
    <div data-role="wrapper" class="sw-fixed sw-overflow-hidden sw-z-[1000] sw-top-0 sw-right-0 lg:sw-max-w-[400px] sw-w-full sw-h-full sw-bg-[linear-gradient(rgb(252,_245,_255)_0%,_rgb(253,_242,_248)_100%)]">
        <div class="sw-relative sw-h-[100vh]">
            <div class="sw-absolute sw-top-0 sw-left-0 sw-w-full sw-h-full sw-z-[100] sw-bg-[rgba(255,255,255,0.8)] sw-hidden group-[&.animating]/cart:sw-block"></div>
            <div class="sw-flex sw-justify-between sw-p-[8px_20px_14px] sw-pt-8 sw-items-center">
                <button data-role="cart-close" class="sw-border-[rgba(168,_85,_247,_0.18)] sw-border-solid sw-border-[1px] sw-bg-[rgba(255,255,255,0.7)] sw-rounded-[12px] sw-w-[38px] sw-h-[38px] sw-flex sw-justify-center sw-items-center">
                    {% render 'icons-v2', icon: 'cart-back', classes: 'sw-w-[26px]' %}  
                </button>
                <h3 class="sw-flex sw-gap-2 sw-items-center"><span>{% render 'icons-v2', icon: 'cart-star'. classes: 'sw-w-[26px]' %}</span><span class="sw-font-primary sw-text-[28px] sw-text-[rgb(88,28,135)] sw-font-bold">Your Cart</span></h3>
                <div class="sw-relative">
                    <span>{% render 'icons-v2', icon: 'cart', classes: 'sw-w-[26px]' %}</span>
                    <span class="{% if cart.item_count > 0 %}active {% endif %}sw-min-h-[23px] sw-minw-[23px] sw-absolute sw-font-secondary sw-top-0 sw-right-0 sw-text-[10px] sw-text-[#fff] -sw-translate-y-1/2 sw-translate-x-1 sw-rounded-full sw-px-2 sw-py-1 sw-bg-[linear-gradient(135deg,_rgb(236,_72,_153),_rgb(168,_85,_247))] sw-hidden [&.active]:sw-flex" data-role="cart-count">{{ cart.item_count }}</span>
                </div>
            </div>
            <div class="sw-hidden group-[&.empty]/cart:sw-block">
                <div class="sw-flex sw-justify-center sw-items-center sw-h-[300px]">
                    <p class="sw-font-primary sw-text-[28px] sw-text-[rgb(88,28,135)] sw-font-bold">No item in the cart</p>
                </div>
            </div>
            <div class="group-[&.empty]/cart:sw-hidden">
                <div data-role="items-wrapper" class="sw-p-[0px_18px_12px] sw-flex sw-flex-col sw-gap-[10px] sw-max-h-[38vh] sw-overflow-auto">
                    {% for item in cart.items %}
                        {% render 'cart-item-v2', line_item: item, index: forloop.index %}
                    {% endfor %}
                </div>
                {% if section.settings.discount_application %}
                    {% render 'discount-form-v2' %}
                {% endif %}
                <div data-role="summary" class="sw-border-[rgba(168,85,247,0.12)] sw-border-solid sw-border-[1px] sw-bg-[#fff] sw-rounded-[22px] sw-p-[16px_18px] sw-m-[4px_18px_12px]">
                    <div class="sw-flex sw-justify-between sw-mb-2">
                        <p class="sw-font-secondary sw-text-[14px] sw-text-[rgba(107,_33,_168,_0.78)] sw-leading-tight">Subtotal</p>
                        <p class="sw-font-secondary sw-text-[14px] sw-text-[rgba(107,_33,_168,_0.78)] sw-leading-tight">{{ cart.items_subtotal_price | money }}</p>
                    </div>
                    <div class="sw-flex sw-justify-between sw-mb-2">
                        <p class="sw-font-secondary sw-text-[14px] sw-text-[rgba(107,_33,_168,_0.78)] sw-leading-tight">Discount</p>
                        <p class="sw-font-secondary sw-text-[14px] sw-text-[rgb(5,150,105)] sw-leading-tight">{{ cart.total_discount | money }}</p>
                    </div>
                    <div class="sw-border-[rgba(168,_85,_247,_0.14)] sw-border-t-[1px] sw-border-solid sw-pt-3 sw-flex sw-justify-between">
                        <p class="sw-font-primary sw-text-[20px] sw-font-bold sw-text-[rgb(88,28,135)]">Total</p>
                        <p class="sw-font-primary sw-text-[20px] sw-font-bold sw-text-[rgb(88,28,135)]">{{ cart.checkout_charge_amount | money }}</p>
                    </div>
                </div>
                <div data-role="checkout-btn" class="sw-p-[14px_18px] sw-sticky sw-top-full">
                    <a class="sw-bg-[linear-gradient(135deg,rgb(236,_72,_153)_0%,rgb(192,38,211)_50%,rgb(147,51,234)_100%)] sw-text-[16px] sw-font-semibold sw-text-[#fff] sw-shadow-[rgba(168,_85,_247,_0.55)_0px_12px_30px_-6px] sw-font-secondary sw-p-[17px_20px] sw-w-full sw-flex sw-gap-2 sw-items-center sw-rounded-full sw-justify-center" href="/checkout"><span>Checkout</span><span>{{ cart.checkout_charge_amount | money }}</span><span>{% render 'icons-v2', icon: 'checkout-star' %}</span></a>
                </div>
            </div>
        </div>
    </div>        
</mini-cart>
{% if section.settings.atc_popup %}
    {% render 'atc-popup-v2' %}
{% endif %}

{% render 'vite-tag' with 'mini-cart-v2.js' %}
{% schema %}
    {
        "name": "mini cart v2",
        "settings": [
            {
                "type":"checkbox",
                "label":"Enable discount application",
                "id":"discount_application",
                "default": true
            },
            {
                "type":"checkbox",
                "label":"Display Add to cart popup",
                "id":"atc_popup",
                "default": true
            }
        ],
        "blocks":[],
        "presets": []
    }
{% endschema %}