{% comment %}
  Section : services-grid.liquid
  Design  : Modern Tarot — "Our Services" section
  Features: Section heading/subtext editable, up to 8 service cards via blocks,
            each card has image, icon, name, description, price, CTA, popular badge
  Tested  : mobile 375px / tablet 768px / desktop 1280px+
{% endcomment %}

<div id="sg-{{ section.id }}" class="sg">

  {%- comment %} ── SECTION HEADER ── {%- endcomment %}
  <div class="sg__header">

    {%- if section.settings.tagline != blank -%}
      <div class="sg__tagline-wrap">
        <span class="sg__tagline">
          {{ section.settings.tagline | escape }}
          {%- if section.settings.tagline_sparkle -%}
            <span class="sg__sparkle" aria-hidden="true">✨</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sg__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="sg__subtext">
        {{ section.settings.subtext | escape }}
        {%- if section.settings.subtext_sparkle -%}
          <span aria-hidden="true"> ✨</span>
        {%- endif -%}
      </p>
    {%- endif -%}

  </div>

  {%- comment %} ── CARDS GRID ── {%- endcomment %}
  {%- if section.blocks.size > 0 -%}
    <div class="sg__grid">
      {%- for block in section.blocks -%}
        <div
          class="sg__card{% if block.settings.is_popular %} sg__card--popular{% endif %}"
          {{ block.shopify_attributes }}
        >

          {%- comment %} Card image with fade ── {%- endcomment %}
          <div class="sg__card-img-wrap">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  class: 'sg__card-img',
                  widths: '300, 400, 600',
                  sizes: '(max-width: 767px) 50vw, (max-width: 1199px) 33vw, 220px',
                  alt: block.settings.image.alt | default: block.settings.name | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'sg__card-img sg__card-img--ph' }}
            {%- endif -%}
            <div class="sg__card-img-fade" aria-hidden="true"></div>
            {%- if block.settings.is_popular -%}
              <div class="sg__badge" aria-label="Popular service">
                Popular
                <span aria-hidden="true">⭐</span>
              </div>
            {%- endif -%}
          </div>

          {%- comment %} Card body ── {%- endcomment %}
          <div class="sg__card-body">

            {%- if block.settings.icon != blank -%}
              <div class="sg__card-icon" aria-hidden="true">{{ block.settings.icon }}</div>
            {%- endif -%}

            {%- if block.settings.name != blank -%}
              <h3 class="sg__card-name">{{ block.settings.name | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="sg__card-desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}

            {%- if block.settings.price != blank -%}
              <div class="sg__card-pricing">
                <span class="sg__card-from">starting from</span>
                <span class="sg__card-price">{{ block.settings.price | escape }}</span>
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <a
                href="{{ block.settings.button_url | default: '#' }}"
                class="sg__card-btn"
                {% if block.settings.button_url == blank %}aria-disabled="true"{% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

<style>
  /* ─────────────────────────────────────────────
     RESET & SCOPE
  ───────────────────────────────────────────── */
  #sg-{{ section.id }},
  #sg-{{ section.id }} * { box-sizing: border-box; }
  #sg-{{ section.id }} p,
  #sg-{{ section.id }} h2,
  #sg-{{ section.id }} h3 { margin: 0; padding: 0; }

  /* ─────────────────────────────────────────────
     CSS TOKENS
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} {
    --col-bg:           {{ section.settings.section_bg }};
    --col-heading:      {{ section.settings.heading_color }};
    --col-subtext:      {{ section.settings.subtext_color }};
    --col-tagline-text: {{ section.settings.tagline_text_color }};
    --col-tagline-border: {{ section.settings.tagline_border_color }};
    --col-name:         {{ section.settings.card_name_color }};
    --col-desc:         {{ section.settings.card_desc_color }};
    --col-from:         {{ section.settings.card_from_color }};
    --col-price:        {{ section.settings.card_price_color }};
    --col-btn-from:     {{ section.settings.btn_color_from }};
    --col-btn-to:       {{ section.settings.btn_color_to }};
    --col-btn-text:     {{ section.settings.btn_text_color }};
    --col-badge-bg:     {{ section.settings.badge_bg_color }};
    --col-badge-text:   {{ section.settings.badge_text_color }};
    --col-card-bg:      {{ section.settings.card_bg_color }};
    --col-card-shadow:  {{ section.settings.card_shadow_color }};
    --radius-card:      {{ section.settings.card_radius }}px;
    --radius-btn:       {{ section.settings.btn_radius }}px;
    --speed:            0.2s;
    --section-px:       clamp(1.25rem, 5vw, 4rem);
    --section-py:       clamp(3rem, 6vw, 5rem);
  }

  /* ─────────────────────────────────────────────
     SECTION SHELL
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} {
    background: var(--col-bg);
    padding: var(--section-py) var(--section-px);
    font-family: inherit;
  }

  /* ─────────────────────────────────────────────
     HEADER
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} .sg__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Tagline pill */
  #sg-{{ section.id }} .sg__tagline-wrap { margin-bottom: 0.25rem; }
  #sg-{{ section.id }} .sg__tagline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--col-tagline-text);
    border: 1.5px solid var(--col-tagline-border);
    border-radius: 100px;
    padding: 6px 18px;
    line-height: 1;
  }
  #sg-{{ section.id }} .sg__sparkle { font-size: 13px; letter-spacing: 0; }

  /* Heading */
  #sg-{{ section.id }} .sg__heading {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: var(--col-heading);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* Subtext */
  #sg-{{ section.id }} .sg__subtext {
    font-size: 15px;
    color: var(--col-subtext);
    font-weight: 400;
    line-height: 1.6;
    max-width: 50ch;
  }

  /* ─────────────────────────────────────────────
     CARDS GRID
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} .sg__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    max-width: 1360px;
    margin: 0 auto;
  }

  /* ─────────────────────────────────────────────
     INDIVIDUAL CARD
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} .sg__card {
    background: var(--col-card-bg);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 24px var(--col-card-shadow);
    transition: transform var(--speed) ease, box-shadow var(--speed) ease;
  }
  #sg-{{ section.id }} .sg__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 36px var(--col-card-shadow);
  }

  /* ─────────────────────────────────────────────
     CARD IMAGE
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} .sg__card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    flex-shrink: 0;
  }
  #sg-{{ section.id }} .sg__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  #sg-{{ section.id }} .sg__card-img--ph {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f9d4f0, #e8c8f8);
  }
  /* Fade-to-white at bottom of image */
  #sg-{{ section.id }} .sg__card-img-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 55%;
    background: linear-gradient(to bottom, transparent 0%, var(--col-card-bg) 100%);
    pointer-events: none;
  }

  /* ─────────────────────────────────────────────
     POPULAR BADGE
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} .sg__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--col-badge-bg);
    color: var(--col-badge-text);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 100px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  /* ─────────────────────────────────────────────
     CARD BODY
  ───────────────────────────────────────────── */
  #sg-{{ section.id }} .sg__card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 1.1rem 1.2rem;
    gap: 0;
    flex: 1;
  }

  /* Icon */
  #sg-{{ section.id }} .sg__card-icon {
    font-size: 28px;
    line-height: 1;
    margin-bottom: 0.55rem;
    display: block;
  }

  /* Service name */
  #sg-{{ section.id }} .sg__card-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--col-name);
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }

  /* Description */
  #sg-{{ section.id }} .sg__card-desc {
    font-size: 12px;
    color: var(--col-desc);
    line-height: 1.55;
    margin-bottom: 0.7rem;
    max-width: 20ch;
  }

  /* Pricing */
  #sg-{{ section.id }} .sg__card-pricing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    margin-bottom: 0.9rem;
    margin-top: auto;
  }
  #sg-{{ section.id }} .sg__card-from {
    font-size: 10.5px;
    color: var(--col-from);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  #sg-{{ section.id }} .sg__card-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--col-price);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  /* CTA Button */
  #sg-{{ section.id }} .sg__card-btn {
    display: block;
    width: 100%;
    padding: 0.72rem 1rem;
    background: linear-gradient(90deg, var(--col-btn-from), var(--col-btn-to));
    color: var(--col-btn-text);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-btn);
    border: none;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: opacity var(--speed) ease, transform var(--speed) ease;
    margin-top: auto;
  }
  #sg-{{ section.id }} .sg__card-btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }
  #sg-{{ section.id }} .sg__card-btn:active { transform: translateY(0); }
  #sg-{{ section.id }} .sg__card-btn[aria-disabled="true"] {
    {% comment %} opacity: 0.4; {% endcomment %}
    pointer-events: none;
  }

  /* ─────────────────────────────────────────────
     TABLET  ≤ 1024px  →  3 columns
  ───────────────────────────────────────────── */
  @media (max-width: 1024px) {
    #sg-{{ section.id }} .sg__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ─────────────────────────────────────────────
     TABLET  ≤ 768px  →  2 columns
  ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    #sg-{{ section.id }} .sg__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    #sg-{{ section.id }} .sg__heading { font-size: clamp(1.5rem, 5vw, 2rem); }
  }

  /* ─────────────────────────────────────────────
     MOBILE  ≤ 480px  →  2 columns (tight)
  ───────────────────────────────────────────── */
  @media (max-width: 480px) {
    #sg-{{ section.id }} {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    #sg-{{ section.id }} .sg__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    #sg-{{ section.id }} .sg__card-body {
      padding: 0.4rem 0.75rem 1rem;
    }
    #sg-{{ section.id }} .sg__card-icon { font-size: 22px; }
    #sg-{{ section.id }} .sg__card-name { font-size: 13px; }
    #sg-{{ section.id }} .sg__card-desc { font-size: 11px; }
    #sg-{{ section.id }} .sg__card-price { font-size: 1.2rem; }
    #sg-{{ section.id }} .sg__card-btn { font-size: 12px; padding: 0.6rem 0.75rem; }
  }

  /* ─────────────────────────────────────────────
     MOBILE  ≤ 360px  →  1 column
  ───────────────────────────────────────────── */
  @media (max-width: 360px) {
    #sg-{{ section.id }} .sg__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

